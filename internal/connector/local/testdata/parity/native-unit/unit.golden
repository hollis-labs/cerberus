# unit: console.service
# Written by Cerberus for resource console-service; `cerberus resource apply` overwrites edits.
[Unit]
Description=Cerberus resource console-service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/u/op
ExecStart="/u/op/.local/bin/console" "web" "--listen" "127.0.0.1:4783" "--open=false"
Restart=always
RestartSec=5
StandardOutput=append:/u/op/.cerberus/apps/console/console-service/logs/stdout.log
StandardError=append:/u/op/.cerberus/apps/console/console-service/logs/stderr.log
Environment="PATH=/u/op/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin"

[Install]
WantedBy=default.target
