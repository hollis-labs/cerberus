#!/bin/sh
# Adapter for helper://cerberus-1password-helper/<vault>/<item>/<field>.
# Only stdout carries a resolved value; no credential is written to disk.
set -eu
if [ "$#" -ne 2 ] || [ "$1" != resolve ]; then
  echo 'usage: cerberus-1password-helper resolve keychain://<vault>/<item>/<field>' >&2
  exit 2
fi
case "$2" in
  keychain://*/*/*) credentialPath=${2#keychain://} ;;
  *) echo 'expected a vault/item/field reference' >&2; exit 2 ;;
esac
opBinary=$(command -v op || true)
if [ -z "$opBinary" ]; then
  for candidate in /opt/homebrew/bin/op /usr/local/bin/op; do
    if [ -x "$candidate" ]; then opBinary=$candidate; break; fi
  done
fi
if [ -z "$opBinary" ]; then echo '1Password CLI (op) is not installed' >&2; exit 1; fi
"$opBinary" read "op://$credentialPath" 2>/dev/null || {
  echo '1Password reference could not be resolved; check item access and CLI authentication' >&2
  exit 1
}
